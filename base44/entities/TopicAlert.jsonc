{
  "name": "TopicAlert",
  "type": "object",
  "properties": {
    "topic_id": {
      "type": "string",
      "description": "ID of the topic"
    },
    "item_id": {
      "type": "string",
      "description": "ID of the newsletter item"
    },
    "is_read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the alert has been read"
    }
  },
  "required": [
    "topic_id",
    "item_id"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "created_by": "{{user.email}}"
    },
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}