{
  "name": "Topic",
  "type": "object",
  "properties": {
    "topic_name": {
      "type": "string",
      "description": "Topic name (e.g., Value-Based Care, AI in Healthcare)"
    },
    "description": {
      "type": "string",
      "description": "Short description of what this topic covers"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Keywords to match against content"
    },
    "icon": {
      "type": "string",
      "description": "Emoji or icon identifier"
    },
    "sort_order": {
      "type": "number",
      "description": "Display order priority"
    }
  },
  "required": [
    "topic_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": {
          "$in": [
            "admin",
            "power",
            "user"
          ]
        }
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}